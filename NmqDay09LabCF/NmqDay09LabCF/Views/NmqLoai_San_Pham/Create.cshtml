@model NmqDay09LabCF.Models.NmqLoai_San_Pham

@{
    ViewData["Title"] = "Thêm Loại Sản Phẩm";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Thêm Loại Sản Phẩm</h4>
        </div>

        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="nmqMaLoai" class="form-label fw-semibold"></label>
                    <input asp-for="nmqMaLoai" class="form-control" placeholder="Nhập mã loại..." />
                    <span asp-validation-for="nmqMaLoai" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="nmqTenLoai" class="form-label fw-semibold"></label>
                    <input asp-for="nmqTenLoai" class="form-control" placeholder="Nhập tên loại..." />
                    <span asp-validation-for="nmqTenLoai" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="nmqTrangThai" />
                    <label class="form-check-label" asp-for="nmqTrangThai"></label>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="nmqIndex" class="btn btn-outline-secondary">
                        ← Quay lại danh sách
                    </a>
                    <input type="submit" value="Create" class="btn btn-primary px-4" />
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
