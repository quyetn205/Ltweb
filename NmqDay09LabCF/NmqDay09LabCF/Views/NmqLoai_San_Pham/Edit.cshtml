@model NmqDay09LabCF.Models.NmqLoai_San_Pham

@{
    ViewData["Title"] = "Chỉnh sửa loại sản phẩm";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0 text-center">Chỉnh sửa loại sản phẩm</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="nmqId" />

                <div class="mb-3">
                    <label asp-for="nmqMaLoai" class="form-label fw-semibold"></label>
                    <input asp-for="nmqMaLoai" class="form-control" placeholder="Nhập mã loại..." />
                    <span asp-validation-for="nmqMaLoai" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="nmqTenLoai" class="form-label fw-semibold"></label>
                    <input asp-for="nmqTenLoai" class="form-control" placeholder="Nhập tên loại..." />
                    <span asp-validation-for="nmqTenLoai" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="nmqTrangThai" id="trangThaiCheck" />
                    <label class="form-check-label" for="trangThaiCheck">
                        @Html.DisplayNameFor(model => model.nmqTrangThai)
                    </label>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="nmqIndex" class="btn btn-outline-secondary px-4">
                        ← Quay lại danh sách
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        💾 Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
