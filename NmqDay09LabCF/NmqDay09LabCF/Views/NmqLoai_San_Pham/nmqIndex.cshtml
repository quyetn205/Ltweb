@model IEnumerable<NmqDay09LabCF.Models.NmqLoai_San_Pham>

@{
    ViewData["Title"] = "Danh Sách Loại Sản Phẩm";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Danh Sách Loại Sản Phẩm</h4>
            <a asp-controller="NmqLoai_San_Pham" asp-action="Create" class="btn btn-light btn-sm fw-semibold">
                ➕ Thêm Mới
            </a>
        </div>

        <div class="card-body">
            <table class="table table-striped align-middle">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.First().nmqMaLoai)</th>
                        <th>@Html.DisplayNameFor(model => model.First().nmqTenLoai)</th>
                        <th>@Html.DisplayNameFor(model => model.First().nmqTrangThai)</th>
                        <th class="text-center" style="width: 180px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.nmqMaLoai</td>
                                <td>@item.nmqTenLoai</td>
                                <td>
                                    @if (item.nmqTrangThai)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-controller="NmqLoai_San_Pham" asp-action="Edit" asp-route-id="@item.nmqId" class="btn btn-sm btn-warning me-1">
                                        ✏️ Sửa
                                    </a>
                                    <a asp-controller="NmqLoai_San_Pham" asp-action="Details" asp-route-id="@item.nmqId" class="btn btn-sm btn-info me-1 text-white">
                                        🔍 Xem
                                    </a>
                                    <a asp-controller="NmqLoai_San_Pham" asp-action="Delete" asp-route-id="@item.nmqId" class="btn btn-sm btn-danger">
                                        🗑️ Xóa
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                Không có dữ liệu để hiển thị.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
